<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lab5Graph"
        x:Class="Lab5Graph.MainWindow"
        Title="Лаб. 5 — обход графа (BFS / DFS)"
        Width="1180"
        Height="840"
        MinWidth="920"
        MinHeight="640"
        Focusable="True">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="Вариант (n1 n2 n3 n4):" />
                <TextBox x:Name="VariantInput" Width="88" MaxLength="4" Text="1239" />
                <Button x:Name="BuildButton" Padding="12,6" Content="Построить граф" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock VerticalAlignment="Center" Text="Режим:" />
                <RadioButton x:Name="ModeBfs" GroupName="Traverse" Content="BFS (в ширину)" IsChecked="True" />
                <RadioButton x:Name="ModeDfs" GroupName="Traverse" Content="DFS (в глубину)" />
                <Separator Width="16" />
                <Button x:Name="StepBackButton" Padding="12,6" Content="Шаг назад (←)" />
                <Button x:Name="StepFwdButton" Padding="12,6" Content="Шаг вперёд (→ / Пробел)" />
                <Button x:Name="ResetStepButton" Padding="12,6" Content="К началу" />
                <TextBlock x:Name="StepCounter" VerticalAlignment="Center" MinWidth="120" />
            </StackPanel>
       </StackPanel>

        <Grid ColumnDefinitions="2*,*">
            <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Ориентированный граф и лес обхода" FontWeight="Bold" Margin="0,0,0,6" />
                    <l:TraversalGraphCanvas x:Name="GraphView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Протокол шагов" FontWeight="Bold" Margin="0,0,0,6" />
                    <ScrollViewer x:Name="ProtocolScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ProtocolText" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
