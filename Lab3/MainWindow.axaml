<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lab3Graph"
        x:Class="Lab3Graph.MainWindow"
        Title="Лаб. 3 — графики (ориентированный и неориентированный)"
        Width="1180"
        Height="820"
        MinWidth="880"
        MinHeight="620">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Text="Вариант (4 цифры n1 n2 n3 n4), напр. 1239:" />
            <TextBox x:Name="VariantInput" Width="88" MaxLength="4" Text="1239" />
            <Button x:Name="BuildButton" Padding="12,6" Content="Построить" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" RowDefinitions="2*,*">
            <Border Grid.Row="0" Grid.Column="0" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Ориентированный граф (Adir)" FontWeight="Bold" Margin="0,0,0,6" />
                    <l:GraphCanvas x:Name="DirectedCanvas" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Неориентированный граф (Aundir)" FontWeight="Bold" Margin="0,0,0,6" />
                    <l:GraphCanvas x:Name="UndirectedCanvas" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MatrixText" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
