<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lab6Graph"
        x:Class="Lab6Graph.MainWindow"
        Title="Лаб. 6 — минимальный остов (Краскал / Прим)"
        Width="1220"
        Height="860"
        MinWidth="920"
        MinHeight="640"
        Focusable="True">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="Вариант (n1 n2 n3 n4):" />
                <TextBox x:Name="VariantInput" Width="88" MaxLength="4" Text="1238" />
                <Button x:Name="BuildButton" Padding="12,6" Content="Построить граф" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="StepBackButton" Padding="12,6" Content="Шаг назад (←)" />
                <Button x:Name="StepFwdButton" Padding="12,6" Content="Шаг вперёд (→ / Пробел)" />
                <Button x:Name="ResetStepButton" Padding="12,6" Content="К началу" />
                <TextBlock x:Name="StepCounter" VerticalAlignment="Center" MinWidth="140" />
            </StackPanel>
            <TextBlock x:Name="LegendText" TextWrapping="Wrap" FontSize="12" Opacity="0.88" />
        </StackPanel>

        <Grid ColumnDefinitions="2*,*">
            <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock x:Name="GraphTitle" Text="Взвешенный граф и остов" FontWeight="Bold" Margin="0,0,0,6" />
                    <l:MstCanvas x:Name="GraphView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Протокол" FontWeight="Bold" Margin="0,0,0,6" />
                    <ScrollViewer x:Name="ProtocolScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ProtocolText" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
