<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             x:Class="Lab6.MainPage"

             Title="Lab6 — Менеджер">



    <ContentPage.MenuBarItems>

        <MenuBarItem Text="Завдання">

            <MenuFlyoutItem Text="Варіант 0: точки → графік" Clicked="OnRunVariant0Clicked" />

        </MenuBarItem>

        <MenuBarItem Text="Файл">

            <MenuFlyoutItem Text="Вихід" Clicked="OnExitClicked" />

        </MenuBarItem>

    </ContentPage.MenuBarItems>



    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Lab6 — керування Object2 та Object3"

               FontSize="18"

               FontAttributes="Bold" />

        <Button Text="Варіант 0: точки → графік"

                Clicked="OnRunVariant0Clicked"

                HorizontalOptions="Start" />

        <HorizontalStackLayout Spacing="8">

            <Button Text="Object2: Clipboard"

                    Clicked="OnOpenObject2Clicked"

                    HorizontalOptions="Start" />

            <Button Text="Відкрити Object3"

                    Clicked="OnOpenObject3Clicked"

                    HorizontalOptions="Start" />

        </HorizontalStackLayout>

        <Label x:Name="StatusLabel"

               Text="«Варіант 0» — результат у Lab6. Object2 без .app (лише Clipboard). Object3 — окреме вікно з графіком."

               LineBreakMode="WordWrap" />

    </VerticalStackLayout>



</ContentPage>


