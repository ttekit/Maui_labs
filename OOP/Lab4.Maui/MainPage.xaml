<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab4.MainPage"
             Title="Lab4 — MyEditor">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Файл">
            <MenuFlyoutItem Text="Вихід" Clicked="OnExitClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Об'єкти">
            <MenuFlyoutItem Text="Крапка" Clicked="OnPointClicked" />
            <MenuFlyoutItem Text="Лінія" Clicked="OnLineClicked" />
            <MenuFlyoutItem Text="Прямокутник" Clicked="OnRectClicked" />
            <MenuFlyoutItem Text="Еліпс" Clicked="OnEllipseClicked" />
            <MenuFlyoutItem Text="Лінія з кружечками" Clicked="OnLineOClicked" />
            <MenuFlyoutItem Text="Каркас куба" Clicked="OnCubeClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Довідка">
            <MenuFlyoutItem Text="Про програму" Clicked="OnAboutClicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,*">
        <ScrollView Grid.Row="0" Orientation="Horizontal" Padding="8,4">
            <HorizontalStackLayout Spacing="4">
                <Button Text="●" Clicked="OnPointClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Крапка" />
                <Button Text="╱" Clicked="OnLineClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Лінія" />
                <Button Text="▭" Clicked="OnRectClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Прямокутник" />
                <Button Text="○" Clicked="OnEllipseClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Еліпс" />
                <Button Text="◎" Clicked="OnLineOClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Лінія з кружечками" />
                <Button Text="⬡" Clicked="OnCubeClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Каркас куба" />
            </HorizontalStackLayout>
        </ScrollView>
        <GraphicsView x:Name="CanvasView"
                      Grid.Row="1"
                      BackgroundColor="White"
                      StartInteraction="OnStartInteraction"
                      DragInteraction="OnDragInteraction"
                      EndInteraction="OnEndInteraction" />
    </Grid>

</ContentPage>
