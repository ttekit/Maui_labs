<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1.MainPage"
             Title="Lab1"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0"
              BackgroundColor="#DDDDDD"
              HeightRequest="40">
            <HorizontalStackLayout Padding="8,0"
                                   Spacing="0"
                                   VerticalOptions="Center">
                <Button x:Name="WorksMenuButton"
                        Text="Роботи"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="12,6"
                        FontSize="14"
                        FontAttributes="Bold"
                        MinimumHeightRequest="32"
                        Clicked="OnWorksMenuClicked" />
            </HorizontalStackLayout>
        </Grid>

        <Border x:Name="WorksSubmenu"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#C8C8C8"
                StrokeThickness="0,0,1,0"
                Padding="8,0">
            <VerticalStackLayout Spacing="0">
                <Button Text="Робота1"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="12,10"
                        FontSize="14"
                        HorizontalOptions="Start"
                        Clicked="OnWork1Clicked" />
                <Button Text="Робота2"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        BorderWidth="0"
                        CornerRadius="0"
                        Padding="12,10"
                        FontSize="14"
                        HorizontalOptions="Start"
                        Clicked="OnWork2Clicked" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" Padding="20">
            <Label x:Name="DisplayLabel"
                   Text=""
                   FontSize="18"
                   TextColor="Black"
                   VerticalOptions="Start"
                   HorizontalOptions="Start" />
        </Grid>
    </Grid>

</ContentPage>
