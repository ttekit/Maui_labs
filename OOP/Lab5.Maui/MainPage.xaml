<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab5.MainPage"
             Title="Lab5 — Singleton + Таблиця">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Файл">
            <MenuFlyoutItem Text="Завантажити з файлу" Clicked="OnLoadClicked" />
            <MenuFlyoutItem Text="Очистити файл" Clicked="OnClearClicked" />
            <MenuFlyoutItem Text="Вихід" Clicked="OnExitClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Таблиця">
            <MenuFlyoutItem Text="Показати таблицю" Clicked="OnShowTableClicked" />
            <MenuFlyoutItem Text="Закрити таблицю" Clicked="OnCloseTableClicked" />
        </MenuBarItem>
        <MenuBarItem Text="Об'єкти">
            <MenuFlyoutItem Text="Крапка" Clicked="OnPointClicked" />
            <MenuFlyoutItem Text="Лінія" Clicked="OnLineClicked" />
            <MenuFlyoutItem Text="Прямокутник" Clicked="OnRectClicked" />
            <MenuFlyoutItem Text="Еліпс" Clicked="OnEllipseClicked" />
            <MenuFlyoutItem Text="Лінія з кружечками" Clicked="OnLineOClicked" />
            <MenuFlyoutItem Text="Каркас куба" Clicked="OnCubeClicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <ScrollView Grid.Row="0" Orientation="Horizontal" Padding="8,4">
            <HorizontalStackLayout Spacing="4">
                <Button x:Name="BtnTable" Text="Таблиця" Clicked="OnShowTableClicked"
                        FontSize="14" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        Padding="12,4" SemanticProperties.Description="Показати таблицю об'єктів" />
                <Button x:Name="BtnLoad" Text="Завантажити" Clicked="OnLoadClicked"
                        FontSize="14" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        Padding="12,4" SemanticProperties.Description="Завантажити з shapes.txt" />
                <Button x:Name="BtnClear" Text="Очистити" Clicked="OnClearClicked"
                        FontSize="14" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        Padding="12,4" SemanticProperties.Description="Очистити canvas, таблицю та shapes.txt" />
                <BoxView WidthRequest="1" HeightRequest="32" Color="#CCCCCC" VerticalOptions="Center" />
                <Button Text="●" Clicked="OnPointClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Крапка" />
                <Button Text="╱" Clicked="OnLineClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Лінія" />
                <Button Text="▭" Clicked="OnRectClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Прямокутник" />
                <Button Text="○" Clicked="OnEllipseClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Еліпс" />
                <Button Text="◎" Clicked="OnLineOClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Лінія з кружечками" />
                <Button Text="⬡" Clicked="OnCubeClicked" WidthRequest="44"
                        FontSize="18" TextColor="Black" BackgroundColor="White" BorderColor="#CCCCCC" BorderWidth="1"
                        SemanticProperties.Description="Каркас куба" />
            </HorizontalStackLayout>
        </ScrollView>
        <Label Grid.Row="1"
               Margin="8,0,8,4"
               FontSize="12"
               TextColor="Gray"
               Text="Таблиця — модальне вікно з координатами фігур. Файл shapes.txt у папці даних застосунку." />
        <GraphicsView x:Name="CanvasView"
                      Grid.Row="2"
                      BackgroundColor="White"
                      StartInteraction="OnStartInteraction"
                      DragInteraction="OnDragInteraction"
                      EndInteraction="OnEndInteraction" />
    </Grid>

</ContentPage>
