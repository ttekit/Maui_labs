<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lab4Graph"
        x:Class="Lab4Graph.MainWindow"
        Title="Лаб. 4 — характеристики графа и связность"
        Width="1240"
        Height="880"
        MinWidth="900"
        MinHeight="640">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Text="Вариант (4 цифры n1 n2 n3 n4), напр. 1239:" />
            <TextBox x:Name="VariantInput" Width="88" MaxLength="4" Text="1239" />
            <Button x:Name="BuildButton" Padding="12,6" Content="Построить" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Этап 1–2: k₁, характеристики">
                <Grid RowDefinitions="2*,*" ColumnDefinitions="*,*">
                    <Border Grid.Row="0" Grid.Column="0" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Ориентированный граф (Adir, k₁)" FontWeight="Bold" Margin="0,0,0,6" />
                            <l:GraphCanvas x:Name="DirectedCanvas1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Неориентированный граф (Aundir)" FontWeight="Bold" Margin="0,0,0,6" />
                            <l:GraphCanvas x:Name="UndirectedCanvas1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReportPhase1" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Этап 3–4: k₂, пути, замыкание, конденсация">
                <Grid RowDefinitions="2*,*" ColumnDefinitions="*,*">
                    <Border Grid.Row="0" Grid.Column="0" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Орграф (Adir, k₂)" FontWeight="Bold" Margin="0,0,0,6" />
                            <l:GraphCanvas x:Name="DirectedCanvas2" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Граф конденсации (по КСС)" FontWeight="Bold" Margin="0,0,0,6" />
                            <l:GraphCanvas x:Name="CondensationCanvas" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReportPhase2" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
